file = {:C$\backslash$:/Users/amitrani/Documents/Mendeley/Ortenzi et al. - 2013 - Virginia Tech Comprehensive Power-based Fuel Consumption Model ( VT- CPFM ) Model Validation and Calibration Con.pdf:pdf},
