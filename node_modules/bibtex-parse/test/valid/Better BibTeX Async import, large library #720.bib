file = {:C$\backslash$:/Users/amitrani/Documents/Mendeley/Wang et al. - 2016 - Integrated Optimization Model for Shelter Allocation and Evacuation Routing with Consideration of Reliability.pdf:pdf},
isbn = {8615801657},
