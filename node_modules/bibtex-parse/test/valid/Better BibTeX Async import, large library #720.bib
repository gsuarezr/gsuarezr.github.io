pages = {96--104},
title = {{Cumulative Impacts of Carsharing and Unbundled Parking on Vehicle Ownership and Mode Choice}},
url = {http://trb.metapress.com/openurl.asp?genre=article{\&}id=doi:10.3141/2319-11},
volume = {2319},
year = {2012}
}
