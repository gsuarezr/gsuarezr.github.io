isbn = {0361-1981},
issn = {0361-1981},
number = {-1},
pages = {116--127},
title = {{Integrating Parental Attitudes in Research on Children's Active School Commuting}},
url = {http://trb.metapress.com/openurl.asp?genre=article{\&}id=doi:10.3141/2318-14},
volume = {2318},
