number = {-1},
pages = {24--30},
title = {{How to Forecast Cruise Ship Arrivals for a New Port-of-Call Destination}},
url = {http://trb.metapress.com/openurl.asp?genre=article{\&}id=doi:10.3141/2330-04},
volume = {2330},
