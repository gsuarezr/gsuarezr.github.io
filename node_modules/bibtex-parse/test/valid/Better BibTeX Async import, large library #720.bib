doi = {10.3141/2436-12},
file = {:C$\backslash$:/Users/amitrani/Documents/Mendeley/Kraus, Quiroga, Le - 2014 - Strategies to Optimize the Management of Right-of-Way Parcel and Utility Information.pdf:pdf},
