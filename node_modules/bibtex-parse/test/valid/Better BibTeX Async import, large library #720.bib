file = {:C$\backslash$:/Users/amitrani/Documents/Mendeley/Pessaro, Songchitruksa - 2014 - Impacts to Transit from Seattle, Washington, Urban Partnership Agreement Program.pdf:pdf},
isbn = {9798459873},
issn = {0361-1981},
number = {2450},
