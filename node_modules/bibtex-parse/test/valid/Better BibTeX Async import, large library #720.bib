number = {2362},
pages = {9--15},
title = {{Using Onboard Sound Intensity Measurements to Interpret Results of Traffic Noise Modeling}},
url = {http://trrjournalonline.trb.org/doi/10.3141/2362-02},
volume = {2362},
year = {2013}
}
