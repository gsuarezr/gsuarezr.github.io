title = {{Empirical Evaluation of Transit Signal Priority through Fusion of Heterogeneous Transit and Traffic Signal Data and Novel Performance Measures}},
url = {http://trid.trb.org/view.aspx?id=1339203},
volume = {500},
year = {2015}
}
