{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "jupyter": {
      "type": "object",
      "properties": {
        "jupytext": {
          "type": "object",
          "properties": {
            "text_representation": {
              "type": "object",
              "properties": {
                "extension": {
                  "type": "string"
                },
                "format_name": {
                  "type": "string"
                },
                "format_version": {
                  "type": "string"
                },
                "jupytext_version": {
                  "type": "string"
                }
              },
              "required": [
                "extension",
                "format_name",
                "format_version",
                "jupytext_version"
              ]
            }
          },
          "required": [
            "text_representation"
          ]
        },
        "kernelspec": {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "display_name",
            "language",
            "name"
          ]
        }
      },
      "required": [
        "jupytext",
        "kernelspec"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date"
  ]
}